# Required: Supabase project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Backend only. Never put this value in frontend files or commit it.
SUPABASE_SECRET_KEY=your_secret_key

# Legacy Supabase variable names are also accepted by the backend:
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional server settings
SCIPILOT_ENV=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Process-local abuse protection. Use a shared gateway/Redis limiter as well
# when multiple backend instances are deployed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=6
RATE_LIMIT_MODEL_REQUESTS=20
RATE_LIMIT_KNOWLEDGE_REQUESTS=30
RATE_LIMIT_MAX_BUCKETS=10000

# Durable long-task worker. One worker is started with the FastAPI process;
# Supabase leases keep multiple backend processes from claiming the same job.
RESEARCH_JOB_WORKER_ENABLED=true
RESEARCH_JOB_POLL_SECONDS=2
RESEARCH_JOB_LEASE_SECONDS=300

# Secure default: require Supabase email confirmation. Local-only acceptance
# environments may opt into automatic confirmation in backend/.env.
AUTH_AUTO_CONFIRM_EMAIL=false
# Add this exact URL to Supabase Auth -> URL Configuration -> Redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Optional local-only acceptance account. Keep disabled in shared/production
# environments. When enabled, set a strong password in backend/.env only.
LOCAL_DEMO_MODE=false
LOCAL_DEMO_EMAIL=demo@scipilot.local
LOCAL_DEMO_PASSWORD=
LOCAL_DEMO_USERNAME=本地验收用户

# Optional SciPilot fine-tuned Xunfei MaaS model. These values are backend-only.
# The LoRA resource ID is sent as the upstream lora_id request header.
SCIPILOT_LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SCIPILOT_LLM_API_KEY=
SCIPILOT_LLM_MODEL_ID=
SCIPILOT_LLM_RESOURCE_ID=
SCIPILOT_LLM_TIMEOUT_SECONDS=120
SCIPILOT_LLM_TEMPERATURE=0.3
SCIPILOT_LLM_MAX_TOKENS=2048
# Optional published prices. Leave blank when the service card does not expose
# a reliable CNY price; the dashboard will show cost as unknown instead of guessing.
SCIPILOT_LLM_INPUT_COST_CNY_PER_1M_TOKENS=
SCIPILOT_LLM_OUTPUT_COST_CNY_PER_1M_TOKENS=

# Optional WebSocket MaaS settings. The current dashboard uses the HTTP
# OpenAI-compatible endpoint; keep these backend-only for a future streaming
# transport. SCIPILOT_LLM_MODEL_ID and SCIPILOT_LLM_RESOURCE_ID are shared by
# both transports. Never expose APIKey or APISecret in VITE_* variables.
SCIPILOT_LLM_WS_URL=wss://maas-api.cn-huabei-1.xf-yun.com/v1.1/chat
SCIPILOT_LLM_WS_APP_ID=
SCIPILOT_LLM_WS_API_KEY=
SCIPILOT_LLM_WS_API_SECRET=

# Optional fallback LLM (non-paper agents)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Xunfei paper-reading Agent. Keep the existing assistant ID variable for
# backward compatibility with the current paper workflow.
XF_AGENT_APP_ID=your_xunfei_app_id
XF_AGENT_API_KEY=your_xunfei_api_key
XF_AGENT_API_SECRET=your_xunfei_api_secret
XF_AGENT_ASSISTANT_ID=your_paper_reading_assistant_id
XF_AGENT_WS_HOST=spark-openapi.cn-huabei-1.xf-yun.com
XF_AGENT_WS_PATH=/v1/assistants/{assistant_id}

# Independent Xunfei Star Agent applications. Each WS_URL is the complete
# interface URL supplied by the platform. Keep every value backend-only.
PROBLEM_DECOMPOSITION_APP_ID=your_problem_decomposition_app_id
PROBLEM_DECOMPOSITION_API_KEY=your_problem_decomposition_api_key
PROBLEM_DECOMPOSITION_API_SECRET=your_problem_decomposition_api_secret
PROBLEM_DECOMPOSITION_WS_URL=wss://your_problem_decomposition_interface_url

PROJECT_PLANNING_APP_ID=your_project_planning_app_id
PROJECT_PLANNING_API_KEY=your_project_planning_api_key
PROJECT_PLANNING_API_SECRET=your_project_planning_api_secret
PROJECT_PLANNING_WS_URL=wss://your_project_planning_interface_url

RESULT_INTERPRETATION_APP_ID=your_result_interpretation_app_id
RESULT_INTERPRETATION_API_KEY=your_result_interpretation_api_key
RESULT_INTERPRETATION_API_SECRET=your_result_interpretation_api_secret
RESULT_INTERPRETATION_WS_URL=wss://your_result_interpretation_interface_url

CODE_REPRODUCTION_APP_ID=your_code_reproduction_app_id
CODE_REPRODUCTION_API_KEY=your_code_reproduction_api_key
CODE_REPRODUCTION_API_SECRET=your_code_reproduction_api_secret
CODE_REPRODUCTION_WS_URL=wss://your_code_reproduction_interface_url

# Shared request-generation settings for all Xunfei Star Agents.
XF_AGENT_DOMAIN=generalv3
XF_AGENT_TEMPERATURE=0.5
XF_AGENT_TOP_K=4
XF_AGENT_MAX_TOKENS=2028
XUNFEI_AGENT_INPUT_COST_CNY_PER_1M_TOKENS=
XUNFEI_AGENT_OUTPUT_COST_CNY_PER_1M_TOKENS=

# In-app AI operations alerts. Rules are evaluated per module over 24 hours.
AI_ALERT_MIN_SAMPLE_SIZE=5
AI_ALERT_FAILURE_RATE=0.30
AI_ALERT_DEGRADED_RATE=0.50
AI_ALERT_P95_LATENCY_MS=120000
AI_ALERT_DAILY_VOLUME=100

# iFlytek Spark ChatDoc external knowledge base. Backend only. Supabase is no
# longer used to store knowledge-base documents, chunks, embeddings or traces.
XFYUN_KB_APP_ID=
XFYUN_KB_API_SECRET=
XFYUN_KB_REPO_ID=
XFYUN_KB_BASE_URL=https://chatdoc.xfyun.cn
XFYUN_KB_CONNECT_TIMEOUT=10
XFYUN_KB_READ_TIMEOUT=600
XFYUN_KB_TOP_N=6
XFYUN_KB_RETRIEVAL_FILTER_POLICY=REGULAR
XFYUN_KB_TEMPERATURE=0.2
# Local query rewrite and RRF/lexical reranking. No additional API key needed.
XFYUN_KB_QUERY_REWRITE_ENABLED=true
XFYUN_KB_MAX_QUERY_VARIANTS=2

# Optional: used only by the resumable batch uploader under KnowledgeBase/.
XFYUN_KB_PAPER_DIR=
