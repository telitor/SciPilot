# Copy to deploy/.env, keep permissions restricted, and replace every placeholder.
# deploy/.env is ignored by Git and is read at container runtime, never built in.

# Deployment identity and public listener. Use an immutable release tag such as
# the 12-character Git commit SHA. The secure default binds only to loopback so
# a host-level TLS proxy/load balancer can publish the service.
SCIPILOT_IMAGE_TAG=replace-with-git-sha
SCIPILOT_BIND_ADDRESS=127.0.0.1
SCIPILOT_PUBLIC_PORT=8080
SCIPILOT_LOG_LEVEL=info
SCIPILOT_INSTALL_OCR=true
SCIPILOT_PDF_OCR_ENABLED=false
SCIPILOT_PDF_OCR_LANGUAGES=eng
SCIPILOT_PDF_OCR_DPI=180
SCIPILOT_PDF_OCR_TIMEOUT_SECONDS=25
SCIPILOT_PDF_OCR_MIN_CONFIDENCE=35
SCIPILOT_BACKEND_MEMORY=2g
SCIPILOT_BACKEND_CPUS=2.0
SCIPILOT_FRONTEND_MEMORY=128m
SCIPILOT_FRONTEND_CPUS=0.50

# Required production safety settings.
SCIPILOT_ENV=production
LOCAL_DEMO_MODE=false
LOCAL_DEMO_EMAIL=demo@scipilot.local
LOCAL_DEMO_PASSWORD=
LOCAL_DEMO_USERNAME=Local acceptance user
AUTH_AUTO_CONFIRM_EMAIL=false
CORS_ORIGINS=https://scipilot.example.org
PASSWORD_RESET_REDIRECT_URL=https://scipilot.example.org/reset-password
MAX_UPLOAD_MB=25

# Required Supabase project settings. Keep the secret/service-role key here only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Process-local abuse protection. A shared edge limiter is still recommended
# when the backend is scaled to more than one replica.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=6
RATE_LIMIT_MODEL_REQUESTS=20
RATE_LIMIT_KNOWLEDGE_REQUESTS=30
RATE_LIMIT_MAX_BUCKETS=10000

# Durable worker. Supabase leases coordinate claims between deployments.
RESEARCH_JOB_WORKER_ENABLED=true
RESEARCH_JOB_POLL_SECONDS=2
RESEARCH_JOB_LEASE_SECONDS=300

# Shared bounded retry/circuit defaults for optional external services. The
# attempt budget applies only to retry-safe ChatDoc reads/status/search; paid
# MaaS/Agent generation and non-idempotent ChatDoc operations stay single-shot.
SCIPILOT_EXTERNAL_CONNECT_TIMEOUT_SECONDS=10
SCIPILOT_EXTERNAL_READ_TIMEOUT_SECONDS=120
SCIPILOT_EXTERNAL_MAX_ATTEMPTS=2
SCIPILOT_EXTERNAL_BACKOFF_INITIAL_SECONDS=0.25
SCIPILOT_EXTERNAL_BACKOFF_MAX_SECONDS=2
SCIPILOT_EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=3
SCIPILOT_EXTERNAL_CIRCUIT_COOLDOWN_SECONDS=30

# Optional SciPilot fine-tuned model. Leave the whole group blank to disable it.
SCIPILOT_LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SCIPILOT_LLM_API_KEY=
SCIPILOT_LLM_MODEL_ID=
SCIPILOT_LLM_RESOURCE_ID=
SCIPILOT_LLM_TIMEOUT_SECONDS=120
SCIPILOT_LLM_TEMPERATURE=0.3
SCIPILOT_LLM_MAX_TOKENS=2048
SCIPILOT_LLM_INPUT_COST_CNY_PER_1M_TOKENS=
SCIPILOT_LLM_OUTPUT_COST_CNY_PER_1M_TOKENS=

# Optional generic model fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional paper-reading Agent. Leave the whole group blank to disable it.
XF_AGENT_APP_ID=
XF_AGENT_API_KEY=
XF_AGENT_API_SECRET=
XF_AGENT_ASSISTANT_ID=
XF_AGENT_WS_HOST=spark-openapi.cn-huabei-1.xf-yun.com
XF_AGENT_WS_PATH=/v1/assistants/{assistant_id}
XF_AGENT_CONNECT_TIMEOUT_SECONDS=10
XF_AGENT_READ_TIMEOUT_SECONDS=120

# Optional independent research Agent applications.
PROBLEM_DECOMPOSITION_APP_ID=
PROBLEM_DECOMPOSITION_API_KEY=
PROBLEM_DECOMPOSITION_API_SECRET=
PROBLEM_DECOMPOSITION_WS_URL=
PROJECT_PLANNING_APP_ID=
PROJECT_PLANNING_API_KEY=
PROJECT_PLANNING_API_SECRET=
PROJECT_PLANNING_WS_URL=
RESULT_INTERPRETATION_APP_ID=
RESULT_INTERPRETATION_API_KEY=
RESULT_INTERPRETATION_API_SECRET=
RESULT_INTERPRETATION_WS_URL=
CODE_REPRODUCTION_APP_ID=
CODE_REPRODUCTION_API_KEY=
CODE_REPRODUCTION_API_SECRET=
CODE_REPRODUCTION_WS_URL=
XF_AGENT_DOMAIN=generalv3
XF_AGENT_TEMPERATURE=0.5
XF_AGENT_TOP_K=4
XF_AGENT_MAX_TOKENS=2028
XUNFEI_AGENT_INPUT_COST_CNY_PER_1M_TOKENS=
XUNFEI_AGENT_OUTPUT_COST_CNY_PER_1M_TOKENS=

# Optional Spark ChatDoc knowledge base.
XFYUN_KB_APP_ID=
XFYUN_KB_API_SECRET=
XFYUN_KB_REPO_ID=
XFYUN_KB_BASE_URL=https://chatdoc.xfyun.cn
XFYUN_KB_CONNECT_TIMEOUT=10
XFYUN_KB_READ_TIMEOUT=600
XFYUN_KB_TOP_N=6
XFYUN_KB_RETRIEVAL_FILTER_POLICY=REGULAR
XFYUN_KB_TEMPERATURE=0.2
XFYUN_KB_QUERY_REWRITE_ENABLED=true
XFYUN_KB_MAX_QUERY_VARIANTS=2

# Existing in-app operational alert thresholds.
AI_ALERT_MIN_SAMPLE_SIZE=5
AI_ALERT_FAILURE_RATE=0.30
AI_ALERT_DEGRADED_RATE=0.50
AI_ALERT_P95_LATENCY_MS=120000
AI_ALERT_DAILY_VOLUME=100

# The production web stack deliberately does not mount the Docker socket.
# Enabling sandbox execution requires a separately reviewed worker deployment.
SCIPILOT_DOCKER_EXECUTION_ENABLED=false
SCIPILOT_DOCKER_IMAGE=python:3.11-slim
SCIPILOT_EXECUTION_TIMEOUT_SECONDS=120
SCIPILOT_EXECUTION_PREPARE_TIMEOUT_SECONDS=300
SCIPILOT_EXECUTION_CPUS=2
SCIPILOT_EXECUTION_MEMORY=2g
SCIPILOT_EXECUTION_MAX_WORKSPACE_MB=1024
