            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Will you come back to contribute? Investigating the inactivity of OSS core developers in GitHub</rdf:li>
            </rdf:Alt>
         </dc:title>
