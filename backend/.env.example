# Required: Supabase project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Backend only. Never put this value in frontend files or commit it.
SUPABASE_SECRET_KEY=your_secret_key

# Legacy Supabase variable names are also accepted by the backend:
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional for backend/scripts/seed_software_engineering_kb.py. Leave blank
# when the project has exactly one profile; otherwise set the intended owner.
SCIPILOT_SEED_USER_ID=

# Optional server settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_KB_UPLOAD_MB=25
MAX_KB_EXTRACTED_CHARS=2000000

# SciPilot trial default: register a confirmed account and return a user session
# immediately, without sending a verification email. Change to false for a
# public production deployment that verifies email ownership through SMTP.
AUTH_AUTO_CONFIRM_EMAIL=true

# Optional SciPilot fine-tuned Xunfei MaaS model. These values are backend-only.
# The LoRA resource ID is sent as the upstream lora_id request header.
SCIPILOT_LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SCIPILOT_LLM_API_KEY=
SCIPILOT_LLM_MODEL_ID=
SCIPILOT_LLM_RESOURCE_ID=
SCIPILOT_LLM_TEMPERATURE=0.3
SCIPILOT_LLM_MAX_TOKENS=2048

# Optional fallback LLM (non-paper agents)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional semantic retrieval. Without these values, the knowledge base uses
# PostgreSQL full-text search and remains fully usable.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Optional iFlytek Spark ChatDoc knowledge base. Backend only.
# off: keep the existing Supabase RAG only
# fallback: use ChatDoc only when Supabase RAG has no citations
# prefer: use ChatDoc first unless a specific Supabase collection is selected
XFYUN_KB_MODE=off
XFYUN_KB_APP_ID=
XFYUN_KB_API_SECRET=
XFYUN_KB_REPO_ID=193588d54888467f8d18001408bc22aa
XFYUN_KB_BASE_URL=https://chatdoc.xfyun.cn
XFYUN_KB_CONNECT_TIMEOUT=10
XFYUN_KB_READ_TIMEOUT=600
XFYUN_KB_TOP_N=6
XFYUN_KB_RETRIEVAL_FILTER_POLICY=REGULAR
XFYUN_KB_TEMPERATURE=0.2
